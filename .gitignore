# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Blender: los .blend se versionan, sus copias de seguridad no
*.blend1
*.blend2
3d/blender_cache/

# Renders intermedios: la copia servida vive en public/3d
3d/exports/

# Python
__pycache__/
*.pyc

# Este proyecto usa pnpm: Netlify instala con pnpm-lock.yaml.
# Un package-lock.json a la vez los desincroniza y rompe el deploy.
package-lock.json
